# Template for /opt/ladu/<env>/.env — the env file deploy/compose/app.yml's
# backend service loads (env_file: .env). One per environment (staging,
# prod), written by the GitHub Environment deploy job from that
# environment's secrets (.dev-context/deployment-strategy.md §2 Secrets).
# Never commit a real .env — this file holds placeholders only.
#
# NODE_ENV and GIT_SHA are NOT here: NODE_ENV=production is baked into
# backend/Dockerfile, GIT_SHA is a build arg baked in at image build time.

DATABASE_URL=postgresql://<db_user>:<db_password>@postgres:5432/<ladu_staging_or_ladu_prod>
JWT_SECRET=<random_secret>
# Signs the admin dashboard's staff tokens. Must differ from JWT_SECRET.
# Optional until the admin slice of .context/plans/admin-dashboard.md deploys:
# without it the server starts and /api/admin/auth/login returns 503.
ADMIN_JWT_SECRET=<another_random_secret>

# The private tool links on the admin health page (Sentry, Healthchecks, Netcup...).
# They must NOT be in the repository, which is public, so this comes from the
# ADMIN_LINKS GitHub Environment secret. Optional: without it the page shows
# generic links. ONE LINE of JSON, every href starting with https://. Do not use
# a literal $ in an address (Compose reads it as a variable): write %24 instead.
# Example (fake addresses):
# ADMIN_LINKS=[{"label":"Sentry","description":"Errors","href":"https://example.test/sentry"}]

BASE_URL=https://<staging_or_app>.<your-domain>
# The Ekilex API key (Estonian dictionary, https://ekilex.ee — account "API key", read-only is enough).
# Without it, Estonian autocomplete answers 502. The base URL defaults to https://ekilex.ee.
EKILEX_API_KEY=<ekilex_api_key>

# Cloudflare Turnstile (captcha on demo start, registration and password reset;
# .context/plans/captcha.md). Create a widget in the Cloudflare dashboard (managed mode,
# hostnames = this environment's domain). The SITE key is public (the app gets it from
# GET /api/access); the SECRET key stays on the server. Both are optional: without them the
# check is off and the admin switch cannot be turned on. Cloudflare's test keys always pass:
#   site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=<turnstile_site_key>
TURNSTILE_SECRET_KEY=<turnstile_secret_key>

# Resend SMTP (staging uses a staging@ sender — see §2 Environments).
# EMAIL_USER is the SMTP auth username, always the literal string "resend"
# — not an email address. EMAIL_FROM is the actual From header, and must be
# an address on the domain verified with Resend: staging@<domain> for
# staging, noreply@<domain> for production.
#
# EMAIL_PORT is 2465, not the standard 465 — Netcup (this project's VPS
# host) blocks outbound 465/587/25 by default (a common anti-abuse policy
# for new VPS accounts; confirmed via `/dev/tcp` connect tests directly from
# the VPS, D-g). Resend documents 2465/2587 as alternate ports specifically
# for providers that do this; 2465 is still implicit TLS, so EMAIL_SECURE
# stays true.
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=2465
EMAIL_SECURE=true
EMAIL_USER=resend
EMAIL_PASS=<resend_api_key>
EMAIL_FROM=<staging_or_noreply>@<your-domain>

# Sentry (backend). Same DSN value in both staging and production Environment
# secrets — same precedent as EMAIL_PASS above (one shared key, simpler for
# a project this size). Not password-grade secret (Sentry DSNs are routinely
# public), kept out of git anyway for consistency with everything else here.
SENTRY_DSN=<sentry_backend_project_dsn>

# OAuth (.dev-context/oauth-login-strategy.md) — Google Cloud OAuth client
# credentials. Redirect URI registered with Google must match this
# environment's BASE_URL + /api/auth/google/callback exactly. (Microsoft
# was planned too but dropped — AADSTS16000 blocked Azure registration on
# every account tried.)
GOOGLE_CLIENT_ID=<google_oauth_client_id>
GOOGLE_CLIENT_SECRET=<google_oauth_client_secret>
# Base URL for building the OAuth callback URI; only needed if it should
# differ from BASE_URL above.
# OAUTH_REDIRECT_BASE=<override_base_url>
