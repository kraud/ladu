{
  "name": "mern-m1",
  "version": "1.0.0",
  "description": "Concurrent multi-language learning tool",
  "main": "server.js",
  "scripts": {
    "build": "npm run build --prefix frontend",
    "start": "node backend/api/index.js",
    "server": "nodemon backend/api/index.js",
    "client": "npm start --prefix frontend",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "test": "jest --forceExit --detectOpenHandles",
    "test:watch": "jest --watch --forceExit --detectOpenHandles",
    "test:coverage": "jest --coverage --forceExit --detectOpenHandles",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "db:studio": "drizzle-kit studio --config backend/drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config backend/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config backend/drizzle.config.ts",
    "db:migrate:test": "NODE_ENV=test drizzle-kit migrate --config backend/drizzle.config.ts"
  },
  "author": "Kevin Raud",
  "license": "MIT",
  "dependencies": {
    "@dnd-kit/core": "6.1.0",
    "@dnd-kit/sortable": "8.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@emotion/react": "11.11.4",
    "@emotion/styled": "11.11.5",
    "@hookform/resolvers": "3.6.0",
    "@mui/icons-material": "5.15.20",
    "@mui/material": "5.15.20",
    "@reduxjs/toolkit": "2.2.5",
    "@tanstack/react-table": "8.17.3",
    "axios": "1.7.2",
    "babel-preset-react-app": "10.0.1",
    "bcryptjs": "^2.4.3",
    "colors": "^1.4.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.1",
    "drizzle-orm": "^0.45.2",
    "english-verbs-gerunds": "^3.3.0",
    "english-verbs-helper": "^3.3.0",
    "english-verbs-irregular": "^3.3.0",
    "express": "^4.18.1",
    "express-async-handler": "^1.2.0",
    "framer-motion": "11.2.11",
    "german-verbs": "^5.3.0",
    "german-verbs-dict": "^3.3.0",
    "german-words": "^5.3.0",
    "german-words-dict": "^3.3.0",
    "is-word": "^1.0.4",
    "jsonwebtoken": "^8.5.1",
    "mongoose": "^6.4.4",
    "nodemailer": "^6.9.14",
    "pg": "^8.22.0",
    "react": "^18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.52.0",
    "react-redux": "9.1.2",
    "react-router-dom": "6.24.0",
    "react-scripts": "5.0.1",
    "react-toastify": "10.0.5",
    "redux": "5.0.1",
    "redux-thunk": "3.1.0",
    "rosaenlg-gender-es": "^4.3.0",
    "spanish-verbs": "^3.3.0",
    "yup": "1.4.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.0.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "concurrently": "^7.6.0",
    "drizzle-kit": "^0.31.10",
    "jest": "^27.5.1",
    "mongodb-memory-server": "^11.1.0",
    "nodemon": "^2.0.19",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
