{
  "compilerOptions": {
    // Target ES2022 to use modern JavaScript features supported by Node.js 18+
    "target": "ES2022",

    // Use CommonJS modules to stay compatible with the existing require() calls
    // in the codebase and the Jest/ts-jest test runner
    "module": "CommonJS",

    // Use Node.js module resolution strategy
    "moduleResolution": "node",

    // TypeScript 6 warns that the legacy "node" resolver is deprecated;
    // keep it during the CommonJS migration and silence that planned-removal warning.
    "ignoreDeprecations": "6.0",

    // Include ES2022 library type definitions
    "lib": ["ES2022"],

    // Enable all strict type-checking options for maximum type safety
    "strict": true,

    // Treat every .ts file as its own module even without import/export syntax
    // (the codebase mixes require()-only files). Without this, TS treats those
    // files as global scripts, so their top-level consts collide across files.
    "moduleDetection": "force",

    // Allow default imports from CommonJS modules (e.g. import express from 'express')
    "esModuleInterop": true,

    // Skip type-checking of declaration files in node_modules for faster builds
    "skipLibCheck": true,

    // Enforce consistent file name casing to avoid issues on case-insensitive file systems
    "forceConsistentCasingInFileNames": true,

    // Output compiled JavaScript files to the dist/ directory
    "outDir": "./dist",

    // The root of the source files (relative to this tsconfig location)
    "rootDir": "./",

    // Allow importing JSON files directly in TypeScript
    "resolveJsonModule": true,

    // Emit decorator metadata (may be needed for future ORM integrations)
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  // Include all TypeScript files under the backend/ directory
  "include": ["**/*.ts"],
  // Exclude compiled output and installed packages.
  // friendshipController.ts and notificationController.ts stay excluded from
  // the typecheck gate: friendships are still deferred (CLAUDE.md), and
  // notifications haven't been touched since Phase 0. tagController.ts was
  // excluded for the same original reason, but phase-4-tags.md's 2026-09-27
  // audit found that deferral note never actually held for tags — the
  // controller was already built out and under active development — so it
  // rejoins the gate as of Phase 4 Slice 2 rather than staying excluded on a
  // stale rationale. See the note in .dev-context/deployment-strategy.md
  // Phase A.
  "exclude": [
    "node_modules",
    "dist",
    "controllers/friendshipController.ts",
    "controllers/notificationController.ts"
  ]
}
