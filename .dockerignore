# Build context for every Dockerfile in this monorepo (all builds run from
# the repo root, since the npm-workspaces lockfile lives here). Keeps the
# context small and prevents host-built artifacts (macOS node_modules,
# frontend/dist, coverage, etc.) from leaking into images that install their
# own dependencies fresh.

**/node_modules

.git

.DS_Store

# env files — real secrets never enter build context; envs are injected at
# deploy time (see .dev-context/deployment-strategy.md §2 Secrets)
.env
*.env
!*.env.example

# build output — rebuilt inside the image, not copied in
dist
frontend/dist
*.tsbuildinfo

# test artifacts
backend/coverage
e2e/test-results
e2e/playwright-report
e2e/blob-report
e2e/.cache

# editors / scratch
.idea
.vscode
.playwright-mcp
