{
  "name": "keelapp-e2e",
  "version": "0.1.0",
  "private": true,
  "description": "Ladu — full-stack Playwright end-to-end suite (per-phase gate verification)",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui --headed",
    "test:smoke": "playwright test --config=playwright.deploy.config.ts",
    "report": "playwright show-report",
    "install:browsers": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.1",
    "@types/pg": "^8.23.1",
    "dotenv": "^17.4.2",
    "pg": "^8.23.0"
  }
}
